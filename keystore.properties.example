# Archivo de configuración del keystore para release
# Copia este archivo a keystore.properties y completa con tus datos reales
# ⚠️ IMPORTANTE: NO subas keystore.properties a git (ya está en .gitignore)

# Ruta al archivo keystore (relativa a la raíz del proyecto)
storeFile=petpal-release-key.jks

# Contraseña del keystore
storePassword=TU_PASSWORD_AQUI

# Alias de la clave
keyAlias=petpal-key

# Contraseña de la clave
keyPassword=TU_PASSWORD_AQUI

