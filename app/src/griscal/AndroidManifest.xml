<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Make LoginActivity the launcher for the griscal flavor -->
    <application>

        <!-- LoginActivity: entry point for griscal -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Griscal multi-category dashboard -->
        <activity
            android:name=".ui.GriscalDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Replace SubjectListActivity entry — no intent-filter, so it's not the launcher -->
        <activity
            android:name=".ui.SubjectListActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            tools:node="replace" />

    </application>
</manifest>
